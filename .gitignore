# Données brutes volumineuses (re-téléchargeables via pipeline/)
data/raw/
data/cache/
*.laz
*.las
*.copc.laz
*.tif
*.tiff
*.pbf
__pycache__/
*.pyc
.venv/
# vecteurs bruts de la commune (volumineux) : versionnés compressés dans data/vector_gz/
data/vector/
*.part
recon/tools/render3d/node_modules/
# --- temporaire : ateliers de reconstruction en cours d'écriture par les agents ---
# (scripts et sorties versionnés à la fin de chaque atelier, après vérification)
recon/stages/
recon/out/*
!recon/out/paquet_jardin/
recon/out/paquet_jardin/*
!recon/out/paquet_jardin/package/
assets/__pycache__/

# --- V2 procédurale (recon/pcg) : on versionne la description, les manifestes, les points et les planches ;
# les sorties lourdes et régénérables (USD fabriqués, EXR, captures brutes UE, caches Karma) restent locales
!recon/out/paquet_jardin/v2/
recon/out/paquet_jardin/v2/fabrique/**/*.usd
recon/out/paquet_jardin/v2/fabrique/**/*.usda
recon/out/paquet_jardin/v2/fabrique/**/*.usdc
# instantané de fabrique/ importé dans UE (copie régénérable : hython fabriquer.py --sortie ...)
recon/out/paquet_jardin/v2/fabrique_ue_snapshot/
# USD, Z et entrees intermediaires du contexte UE (regenerables : python recon/pcg/ue/contexte/contexte.py usd)
recon/out/paquet_jardin/v2/ue_*/usd/
recon/out/paquet_jardin/v2/**/*.exr
recon/out/paquet_jardin/v2/ue_*/**/*.png
!recon/out/paquet_jardin/v2/ue_*/**/planche_*.png
*.rat
# Planches contenant des photos de tiers (photos de référence fournies, Panoramax CC-BY-SA) : locales seulement
recon/out/paquet_jardin/v2/**/planche_photos*.png
recon/out/paquet_jardin/v2/**/planche_panoramax*.png
recon/pc/rendus/**/planche_p_*.png
recon/out/paquet_jardin/v2/fabrique_ue_snapshot/
recon/out/paquet_jardin/v2/enrichi/**/*.jpg
recon/out/paquet_jardin/v2/description/coherence/**/*.jpg
# planches avant / après de la résolution : ortho et photos Panoramax (imagerie tierce), locales
recon/out/paquet_jardin/v2/description/resolue/planches/*.jpg
recon/out/paquet_jardin/v2/enrichi/recensement/**/*.png
recon/out/paquet_jardin/v2/description/enrichi/arbitrages/*.jpg
# Caches du contrôleur, fabrication HDA, grilles et grandes planches : régénérables et déterministes
# (recon/pcg/decrire/*.py, hython recon/pcg/houdini/fabriquer_hda.py, python recon/pcg/controle/verifier_regles.py)
recon/out/paquet_jardin/v2*/controle/cache/
recon/out/paquet_jardin/v2*/controle/rendu/*.hdr
recon/out/paquet_jardin/v2*/fabrique_hda/**/*.usd
recon/out/paquet_jardin/v2*/fabrique_hda/**/*.usda
recon/out/paquet_jardin/v2*/fabrique_hda/**/*.usdc
recon/out/paquet_jardin/v2*/fabrique_hda/points/
recon/out/paquet_jardin/v2*/fabrique_hda/controle/*.png
recon/out/paquet_jardin/v2*/**/*.npz
recon/out/paquet_jardin/v2*/description/controle_sol/*.png
recon/out/paquet_jardin/v2*/description/regularisation/*.png
recon/out/paquet_jardin/v2*/description/couverture_marquages*.png
# État avant travaux (cible depuis le 11/10/2026) : mêmes règles ; photos de tiers et vignettes jamais versionnées
!recon/out/paquet_jardin/v2_avant_travaux/
recon/out/paquet_jardin/**/photos_non_versionnees/
