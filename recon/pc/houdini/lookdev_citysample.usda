                color3f outputs:out
            }

            def Shader "mx_base"
            {
                uniform token info:id = "ND_multiply_color3"
                color3f inputs:in1.connect = </World/Looks/sol_parking_macro/mx_macro.outputs:out>
                color3f inputs:in2.connect = </World/Looks/sol_parking_macro/mx_grain_force.outputs:out>
                color3f outputs:out
            }

            def Shader "mx_surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
