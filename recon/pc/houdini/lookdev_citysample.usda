                color3f inputs:base_color.connect = </World/Looks/sol_parking_macro/mx_base.outputs:out>
                float inputs:metalness = 0
                float3 inputs:normal.connect = </World/Looks/sol_parking_macro/mx_normale.outputs:out>
                float inputs:specular = 1
                float inputs:specular_IOR = 1.5
                float inputs:specular_roughness.connect = </World/Looks/sol_parking_macro/mx_detail_rugosite.outputs:out>
