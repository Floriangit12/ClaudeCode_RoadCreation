#usda 1.0
(
    customLayerData = {
        string contexte = "outputs:mtlx:surface (Karma) ; outputs:surface UsdPreviewSurface inchangé"
        string genere_par = "recon/pc/citysample/preparer_lookdev_citysample.py"
        string textures = "recon/pc/citysample/textures (non versionnées, EULA Unreal Engine)"
    }
    defaultPrim = "World"
    doc = "Look-dev OPTIONNEL City Sample (Karma / MaterialX) du carrefour Paquet Jardin. Couche de surcharges à placer AU-DESSUS du paquet (sublayer le plus fort). Textures non versionnées (EULA Unreal Engine) : recon/pc/citysample/README.md. Généré par recon/pc/citysample/preparer_lookdev_citysample.py."
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    over "Looks"
    {
        over "sol_chaussee_macro"
        {
            token outputs:mtlx:surface.connect = </World/Looks/sol_chaussee_macro/mx_surface.outputs:out>

            def Shader "mx_st1"
            {
                uniform token info:id = "ND_geompropvalue_vector2"
                string inputs:geomprop = "st1"
                float2 outputs:out
            }

            def Shader "mx_uv_detail"
            {
                uniform token info:id = "ND_multiply_vector2FA"
                float2 inputs:in1.connect = </World/Looks/sol_chaussee_macro/mx_st1.outputs:out>
                float inputs:in2 = 0.5
                float2 outputs:out
            }

            def Shader "mx_detail_albedo"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (0.1659, 0.1566, 0.1358)
                asset inputs:file = @./../citysample/textures/asphalt_road_03_albedo.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </World/Looks/sol_chaussee_macro/mx_uv_detail.outputs:out>
                string inputs:uaddressmode = "periodic"
                string inputs:vaddressmode = "periodic"
                color3f outputs:out
            }

            def Shader "mx_detail_rugosite"
            {
                uniform token info:id = "ND_image_float"
                float inputs:default = 0.8
                asset inputs:file = @./../citysample/textures/asphalt_road_03_roughness.png@ (
                    colorSpace = "raw"
                )
                float2 inputs:texcoord.connect = </World/Looks/sol_chaussee_macro/mx_uv_detail.outputs:out>
                string inputs:uaddressmode = "periodic"
                string inputs:vaddressmode = "periodic"
                float outputs:out
            }

            def Shader "mx_detail_normale"
            {
                uniform token info:id = "ND_image_vector3"
                float3 inputs:default = (0.5, 0.5, 1)
                asset inputs:file = @./../citysample/textures/asphalt_road_03_normal.png@ (
                    colorSpace = "raw"
                )
                float2 inputs:texcoord.connect = </World/Looks/sol_chaussee_macro/mx_uv_detail.outputs:out>
                string inputs:uaddressmode = "periodic"
                string inputs:vaddressmode = "periodic"
                float3 outputs:out
            }

            def Shader "mx_normale"
            {
                uniform token info:id = "ND_normalmap_float"
                float3 inputs:in.connect = </World/Looks/sol_chaussee_macro/mx_detail_normale.outputs:out>
                float inputs:scale = 1
                float3 outputs:out
            }

            def Shader "mx_grain"
            {
                uniform token info:id = "ND_multiply_color3"
                color3f inputs:in1.connect = </World/Looks/sol_chaussee_macro/mx_detail_albedo.outputs:out>
                color3f inputs:in2 = (6.0277276, 6.385696, 7.3637705)
                color3f outputs:out
            }

            def Shader "mx_grain_force"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg = (1, 1, 1)
                color3f inputs:fg.connect = </World/Looks/sol_chaussee_macro/mx_grain.outputs:out>
                float inputs:mix = 1
                color3f outputs:out
            }

            def Shader "mx_st"
            {
                uniform token info:id = "ND_geompropvalue_vector2"
                string inputs:geomprop = "st"
                float2 outputs:out
            }

            def Shader "mx_macro"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (0.26, 0.27, 0.25)
                asset inputs:file = @../../out/paquet_jardin/package/textures/albedo_macro_8192.jpg@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </World/Looks/sol_chaussee_macro/mx_st.outputs:out>
                string inputs:uaddressmode = "clamp"
                string inputs:vaddressmode = "clamp"
                color3f outputs:out
            }

            def Shader "mx_base"
            {
                uniform token info:id = "ND_multiply_color3"
                color3f inputs:in1.connect = </World/Looks/sol_chaussee_macro/mx_macro.outputs:out>
                color3f inputs:in2.connect = </World/Looks/sol_chaussee_macro/mx_grain_force.outputs:out>
                color3f outputs:out
            }

            def Shader "mx_surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1
                color3f inputs:base_color.connect = </World/Looks/sol_chaussee_macro/mx_base.outputs:out>
                float inputs:metalness = 0
                float3 inputs:normal.connect = </World/Looks/sol_chaussee_macro/mx_normale.outputs:out>
                float inputs:specular = 1
                float inputs:specular_IOR = 1.5
                float inputs:specular_roughness.connect = </World/Looks/sol_chaussee_macro/mx_detail_rugosite.outputs:out>
                token outputs:out
            }
        }

        over "sol_parking_macro"
