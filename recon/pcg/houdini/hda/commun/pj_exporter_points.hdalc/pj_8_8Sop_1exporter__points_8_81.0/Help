    #id: fichier
    

Hash de la description:
    #id: source_hash
    Vide : attribut de détail pj_hash_description de l'entrée.

Pivot des prototypes:
    #id: pivot
    

Bibliothèque:
    #id: bibliotheque
    

Sens de cd:
    #id: doc_cd
    

Écrire le fichier:
    #id: ecrire
    

