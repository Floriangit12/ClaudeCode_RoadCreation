    outputlabel	2	"Nivellement (HeightField)"
    script	pj::lire_description::1.0
    label	"PJ Lire la description"

    help {
    }

    inputlabel	1	"Entités supplémentaires (facultatif)"

    group {
        name    "f_description"
        label   "Description"

        parm {
            name    "dossier"
            label   "Dossier de la description (base/)"
            type    directory
            default { "D:/ClaudeCode_RoadCreation/recon/out/paquet_jardin/v2/description/base" }
            help    "Dossier base/ de la description v2 : bordures, surfaces, ilots, ponctuels_sol, marquages (.geojson, L93 / NGF), nivellement.json et nivellement_grille.npz."
        }
        parm {
            name    "fam_bordures"
            label   "Bordures"
            type    toggle
            default { "1" }
            help    "Charger la famille bordures (bordures.geojson)."
        }
        parm {
            name    "fam_surfaces"
            label   "Surfaces"
            type    toggle
            default { "1" }
            help    "Charger la famille surfaces (surfaces.geojson)."
        }
        parm {
            name    "fam_ilots"
            label   "Îlots"
            type    toggle
            default { "1" }
            help    "Charger la famille ilots (ilots.geojson)."
        }
        parm {
            name    "fam_ponctuels_sol"
            label   "Ponctuels de sol (BEV)"
            type    toggle
            default { "1" }
            help    "Charger la famille ponctuels_sol (ponctuels_sol.geojson)."
        }
        parm {
            name    "fam_marquages"
            label   "Marquages"
            type    toggle
            default { "1" }
            help    "Charger la famille marquages (marquages.geojson)."
        }
        parm {
            name    "marquages_non_fabriques"
            label   "Garder les marquages non fabriqués"
            type    toggle
            default { "0" }
            help    "Lignes d'arrêt virtuelles et hypothèses non peintes (fabrication.statut = non_fabrique, MQ-LEF-002/011) : groupe non_fabrique, hors des branches."
        }
        parm {
            name    "garder_props"
            label   "Garder les propriétés JSON (props)"
            type    toggle
            default { "1" }
            help    "Attribut de primitive props : propriétés complètes de l'entité en JSON (traçabilité)."
        }
        parm {
            name    "filtre_ids"
            label   "Filtre d'identifiants"
            type    string
            default { "" }
            help    "Motifs séparés par des espaces (fnmatch), ex. « K-03* S-0213a ». Vide : tout."
        }
    }

    group {
        name    "f_emprise"
        label   "Emprise"

        parm {
            name    "emprise"
            label   "Emprise"
            type    ordinal
            default { "0" }
            help    "Entités gardées : celles dont la boîte englobante touche l'emprise (entières, non découpées)."
            menu {
                "site"      "Site complet (carré local de 300 m)"
                "pilote"    "Zone pilote ZP-01"
                "boite"     "Boîte (repère local)"
                "tuile"     "Tuile du site"
            }
        }
        parm {
            name    "boite_min"
            label   "Boîte : x, y min (m)"
            type    vector2
            size    2
            default { "-11" "-28" }
            help    "Coin bas-gauche, repère local (L93 − O)."
            hidewhen "{ emprise != boite }"
            range   { 0 10 }
        }
        parm {
            name    "boite_max"
            label   "Boîte : x, y max (m)"
            type    vector2
            size    2
            default { "60" "72" }
            hidewhen "{ emprise != boite }"
            range   { 0 10 }
        }
        parm {
            name    "tuile_taille"
            label   "Tuile : taille (m)"
            type    float
            default { "64" }
            help    "Tuiles carrées à partir du coin (−150, −150) du site."
            hidewhen "{ emprise != tuile }"
            range   { 1 300 }
        }
        parm {
            name    "tuile_index"
            label   "Tuile : indices i, j"
            type    intvector2
            size    2
            default { "2" "2" }
            hidewhen "{ emprise != tuile }"
            range   { 0 10 }
        }
        parm {
            name    "marge"
            label   "Marge (m)"
            type    float
            default { "0" }
            help    "Élargit l'emprise de chaque côté."
            range   { 0 50 }
        }
    }

    group {
        name    "f_nivellement"
        label   "Altitude et nivellement"

        parm {
            name    "altitude"
            label   "Altitude des sommets"
            type    ordinal
            default { "0" }
            help    "Z des sommets en sortie 1 : bordures au pied de face ; surfaces, îlots et marquages sur le modèle de nivellement de leur région."
            menu {
                "decrite"       "Décrite (Z de la description, sinon nivellement)"
                "nivellement"   "Nivellement (modèle unique TQ-SOL-013)"
                "plat"          "À plat (z = 0)"
            }
        }
        parm {
            name    "charger_nivellement"
            label   "Charger le nivellement (sortie 2)"
            type    toggle
            default { "1" }
            help    "HeightField du modèle unique : height (z0), r0, z1, r1, z2, r2 (pas 0,10 m)."
        }
        parm {
            name    "niv_marge"
            label   "Marge du recadrage (m)"
            type    float
            default { "2" }
            range   { 0 50 }
        }
        parm {
            name    "niv_pas"
            label   "Sous-échantillonnage (1 = 0,10 m)"
            type    integer
            default { "1" }
            help    "Aperçu seulement : au-delà de 1, la requête n'est plus exacte."
            range   { 1 10 }
        }
        parm {
            name    "comblement_rayon"
            label   "Rayon de comblement des trous (m)"
            type    float
            default { "30" }
            help    "Flou normalisé de la couche height sous les bâtiments (affichage)."
            range   { 0 100 }
        }
    }

}
